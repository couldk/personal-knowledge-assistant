PKA_APP_ENV=local
PKA_LOG_LEVEL=INFO

PKA_CHAT_PROVIDER=deepseek
PKA_CHAT_MODEL=deepseek-v4-flash
PKA_CHAT_API_KEY=
PKA_CHAT_BASE_URL=https://api.deepseek.com
PKA_CHAT_TIMEOUT_SECONDS=60
PKA_CHAT_MAX_RETRIES=2
PKA_CHAT_MAX_TOKENS=2048
PKA_CHAT_TEMPERATURE=0

PKA_EMBEDDING_PROVIDER=siliconflow
PKA_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
PKA_EMBEDDING_API_KEY=
PKA_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
PKA_EMBEDDING_DIMENSION=1024
PKA_EMBEDDING_BATCH_SIZE=32
PKA_EMBEDDING_TIMEOUT_SECONDS=30
PKA_EMBEDDING_MAX_RETRIES=2

# PostgreSQL + pgvector
PKA_POSTGRES_USER=pka
PKA_POSTGRES_PASSWORD=pka-local-password
PKA_POSTGRES_DB=personal_knowledge
PKA_POSTGRES_PORT=5432

PKA_VECTOR_STORE_PROVIDER=pgvector
PKA_DATABASE_URL=postgresql://pka:pka-local-password@localhost:5432/personal_knowledge
PKA_DATABASE_SCHEMA=pka
PKA_DATABASE_CONNECT_TIMEOUT_SECONDS=10
PKA_DATABASE_POOL_MIN_SIZE=1
PKA_DATABASE_POOL_MAX_SIZE=10

PKA_CHUNK_SIZE=512
PKA_CHUNK_OVERLAP=64
PKA_RETRIEVAL_TOP_K=5

PKA_AGENT_MAX_RETRIEVAL_ATTEMPTS=2
PKA_AGENT_MIN_RELEVANCE_SCORE=0.35

# LangSmith 可观测性
# 本地测试默认关闭，开启后 LangGraph 会自动上传 Trace。
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=personal-knowledge-assistant-day6

# 默认美国区域。
# 如果账户属于其他区域，需要换成对应 Endpoint。
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# API Key 关联多个 Workspace 时才需要配置。
LANGSMITH_WORKSPACE_ID=

# 文档上传
PKA_UPLOAD_DIRECTORY=data/uploads
PKA_UPLOAD_MAX_BYTES=10485760